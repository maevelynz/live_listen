# LiveListen Web (staging) - env template

NEXT_PUBLIC_APP_ENV=staging

# Public API base URL (must match deployed staging API)
NEXT_PUBLIC_API_URL=https://api-staging.livelisten.com

# Socket.IO URL
# For socket.io-client, prefer http(s) URL. If you use ws(s), client should convert.
NEXT_PUBLIC_WS_URL=https://api-staging.livelisten.com

# Public app URL for invite links (optional but useful)
NEXT_PUBLIC_APP_URL=https://staging.livelisten.com
