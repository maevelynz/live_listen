# LiveListen Web - Environment Variables Example
# Copy this file to .env.local and fill in the values for your environment
# Note: Next.js requires NEXT_PUBLIC_* prefix for client-accessible variables

# Environment Configuration
# This is exposed to the browser (NEXT_PUBLIC_* prefix)
NEXT_PUBLIC_APP_ENV=local

# API Configuration
# Local: http://localhost:3001
# Staging: https://api-staging.livelisten.com
# Production: https://api.livelisten.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# WebSocket Configuration
# Local: ws://localhost:3001
# Staging: wss://api-staging.livelisten.com
# Production: wss://api.livelisten.com
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# App URL (for generating invite links)
# Local: http://localhost:3000
# Staging: https://staging.livelisten.com
# Production: https://livelisten.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Analytics
# NEXT_PUBLIC_ANALYTICS_ID=
# ENABLE_ANALYTICS=false

# Optional: Error Tracking (Sentry)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=
