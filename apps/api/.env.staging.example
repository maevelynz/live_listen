# LiveListen API (staging) - env template

APP_ENV=staging
NODE_ENV=production

PORT=3001

# Managed Postgres with SSL required.
# Example (Neon/Supabase/Railway): postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/livelisten_staging?sslmode=require

# CORS must match the staging web origin.
# Example: https://staging.livelisten.com OR a stable Vercel staging domain
CORS_ORIGIN=https://staging.livelisten.com

# Socket.IO CORS origin should match the same frontend origin.
SOCKET_IO_CORS_ORIGIN=https://staging.livelisten.com

# Logging
# Options: debug, info, warn, error
LOG_LEVEL=info

# Optional rate limiting (if supported by API)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100

# JWT secret for signing auth tokens
JWT_SECRET=CHANGE_ME_STAGING
