# LiveListen API (production) - env template

APP_ENV=production
NODE_ENV=production

PORT=3001

# Managed Postgres with SSL required.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/livelisten_production?sslmode=require

# CORS must match the production web origin.
CORS_ORIGIN=https://livelisten.com

# Socket.IO CORS origin should match the same frontend origin.
SOCKET_IO_CORS_ORIGIN=https://livelisten.com

# Logging
# Options: debug, info, warn, error
LOG_LEVEL=warn

# Optional rate limiting (if supported by API)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100

# JWT secret for signing auth tokens
JWT_SECRET=CHANGE_ME_PRODUCTION
