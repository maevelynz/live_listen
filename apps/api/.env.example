# LiveListen API - Environment Variables Example
# Copy this file to .env and fill in the values for your environment

# Environment Configuration
APP_ENV=local
NODE_ENV=development

# Server Configuration
PORT=3001

# Database Configuration
# Local: postgresql://livelisten:livelisten@localhost:5432/livelisten
# Staging: [Managed PostgreSQL connection string with SSL]
# Production: [Managed PostgreSQL connection string with SSL]
DATABASE_URL=postgresql://livelisten:livelisten@localhost:5432/livelisten

# CORS Configuration
# Local: http://localhost:3000
# Staging: https://staging.livelisten.com
# Production: https://livelisten.com
CORS_ORIGIN=http://localhost:3000

# Socket.IO Configuration
# Local: http://localhost:3000
# Staging: https://staging.livelisten.com
# Production: https://livelisten.com
SOCKET_IO_CORS_ORIGIN=http://localhost:3000

# Logging Configuration
# Options: debug, info, warn, error
LOG_LEVEL=debug

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Optional: Feature Flags
# ENABLE_ANALYTICS=false
# ENABLE_ERROR_TRACKING=false
# ENABLE_REDIS=false

# Optional: Error Tracking (Sentry)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=

# Optional: Redis (Future)
# REDIS_URL=
# REDIS_PASSWORD=
